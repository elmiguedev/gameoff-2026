{
  "name": "gameoff-2026",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "dev:rooms": "vite --open \"/?dev=rooms\"",
    "build": "vite build --outDir build --base=./",
    "deploy:itchio": "bun run build && mkdir -p deploy && rm -f deploy/shift-itchio.zip && cd build && zip -r ../deploy/shift-itchio.zip .",
    "preview": "vite preview",
    "typecheck": "bun check src/index.ts"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "vite": "^8.3.8"
  },
  "peerDependencies": {
    "typescript": "^7"
  },
  "dependencies": {
    "phaser": "^4.2.1"
  }
}
